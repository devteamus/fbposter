# Secrets — never commit real env files
.env
.env.local
.env.*.local
*.pem
*.key

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/npm-debug.log*

# Python
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Local data (mounted as Docker volumes in production — never belongs in git)
backend/data/
backend/uploads/
*.db
*.sqlite

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
